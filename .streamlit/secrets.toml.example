# Copy this file to .streamlit/secrets.toml on your own computer.
# Never commit the real secrets.toml file.

CDSE_CLIENT_ID = "your-client-id"
CDSE_CLIENT_SECRET = "your-client-secret"

# Alternative supported structure:
# [copernicus]
# client_id = "your-client-id"
# client_secret = "your-client-secret"
